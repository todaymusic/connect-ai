# ─────────────────────────────────────────────────────────────
# OMU 환경변수 예시
#  - 로컬: 이 파일을 복사해 .env.local 로 만들고 값을 채운다 (cp .env.example .env.local)
#  - Vercel: Project → Settings → Environment Variables 에 같은 이름으로 입력
#  - .env.local 은 .gitignore 대상이다. 실제 키를 이 파일에 적어 커밋하지 말 것.
#  - NEXT_PUBLIC_ 으로 시작하는 값은 브라우저에 그대로 노출된다. 비밀값은 절대 NEXT_PUBLIC_ 로 만들지 말 것.
# ─────────────────────────────────────────────────────────────

# ── Supabase (필수) ─────────────────────────────────────────
# Supabase 대시보드 → Project Settings → API (또는 Data API)
# 비워 두면 사이트는 '데모 모드'로 동작한다: 목데이터로 화면만 보이고 로그인 버튼은 비활성.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# anon(public) 키. 새 형식(sb_publishable_...)도 사용 가능. 공개돼도 되는 키이며 RLS 로 보호된다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role(secret) 키 — 현재 코드에서는 사용하지 않는다.
# 추후 서버 전용 작업(일괄 업로드 스크립트 등)에 쓸 때만 설정하고, 절대 NEXT_PUBLIC_ 을 붙이지 말 것.
# SUPABASE_SERVICE_ROLE_KEY=

# ── 사이트 주소 (필수) ───────────────────────────────────────
# canonical·OG·sitemap 기준 주소. 끝에 / 없이. 비우면 Vercel 배포 주소 → localhost 순으로 추정한다.
# 로컬: http://localhost:3000 / 운영: https://omu.kr (정식 도메인 연결 후)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 소셜 로그인 ─────────────────────────────────────────────
# 카카오/네이버의 Client ID·Secret 은 여기가 아니라 Supabase 대시보드(Authentication → Providers)에 입력한다.
# 이 앱에는 '어떤 버튼을 켤지'만 알려준다. 자세한 설정: DEPLOYMENT.md, docs/AUTH.md

# 카카오: Supabase 내장 Provider('kakao'). 기본 켜짐. Supabase 에서 Kakao 를 켜기 전이라면 false 로 두면 '준비 중' 표시.
NEXT_PUBLIC_AUTH_KAKAO_ENABLED=true

# 이메일 로그인 링크(비밀번호 없음): 기본 켜짐. 카카오 키가 없어도 관리자가 /admin 에 들어올 수 있다.
# Supabase 환경변수가 없는 데모 모드에서는 화면에 나오지 않는다. 소셜 로그인만 쓰려면 false (Redeploy 필요).
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true

# 네이버: Supabase 내장 Provider 가 아니라 '커스텀 OAuth2 Provider' 로 등록한 식별자를 넣는다.
# 반드시 custom: 으로 시작 (예: custom:naver). 비워 두면 버튼이 '네이버 로그인 준비 중' 으로 비활성화된다.
NEXT_PUBLIC_NAVER_PROVIDER_ID=

# ── 게시판 열기 (선택) ──────────────────────────────────────
# 중고 장터·구인 글쓰기는 기본으로 닫혀 있다('준비 중'). 열 게시판을 쉼표로 적는다.
#   market  = 중고 장터 판매·구매·나눔 글       recruit = 구인·모집 글
# 예) 둘 다 열기: NEXT_PUBLIC_OMU_OPEN_WRITE=market,recruit
# 비우면 둘 다 닫힘. 화면과 서버 액션 모두 이 값을 따른다. 빌드 때 들어가는 값이라 바꾸면 Redeploy 필요.
NEXT_PUBLIC_OMU_OPEN_WRITE=

# ── 검색엔진 소유확인 (오픈 시 입력, 선택) ────────────────────
# 구글 서치콘솔 HTML 태그의 content 값 / 네이버 서치어드바이저 HTML 태그의 content 값
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=

# ── 개발 전용 (운영 Vercel 에는 설정하지 말 것) ──────────────
# Supabase 미연결 상태에서 'next start'(운영 모드)로도 /admin 목데이터 미리보기를 보고 싶을 때만 1.
# (개발 서버 'npm run dev' 에서는 이 값 없이도 미리보기가 보인다)
# OMU_ADMIN_PREVIEW=1

# Supabase 가 연결돼 있어도 목록·상세·글쓰기를 목데이터(데모 모드)로 보고 싶을 때만 demo.
# 데모 모드 글쓰기는 서버에 저장하지 않고 브라우저에만 보관한다. 운영 Vercel 에는 넣지 말 것.
# OMU_DATA_SOURCE=demo
